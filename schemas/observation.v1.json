{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hammertime.dev/schemas/observation.v1.json",
  "title": "AgentObservationMessage",
  "type": "object",
  "required": ["agent_id", "sequence", "window_start", "window_seconds", "observations"],
  "additionalProperties": false,
  "properties": {
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "window_start": { "type": "string", "format": "date-time" },
    "window_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["ip", "request_count"],
        "additionalProperties": false,
        "properties": {
          "ip": { "type": "string" },
          "request_count": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
        }
      }
    }
  }
}
