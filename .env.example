# --- shared -----------------------------------------------------------------
HAMMERTIME_ENV=local
HAMMERTIME_LOG_LEVEL=info
HAMMERTIME_CONFIG_PATH=./config/detection.v1.json
# Process lifecycle (ADR-0009, spec 47). Startup deadline: how long a service
# retries an unavailable bus/store (0.5s backoff doubling to a 5s cap) before
# failing with status 1. Shutdown deadline: how long the drain may take before
# it is reported as a failure -- keep it under the container stop grace period
# (Docker's default is 10s). Config poll: how often HAMMERTIME_CONFIG_PATH is
# re-read; a document only takes effect if its config_version is strictly
# greater than the one in force.
HAMMERTIME_STARTUP_TIMEOUT_S=60
HAMMERTIME_SHUTDOWN_TIMEOUT_S=8
HAMMERTIME_CONFIG_POLL_INTERVAL_S=1.0

# --- event log --------------------------------------------------------------
HAMMERTIME_BUS_KIND=kafka            # kafka | memory
HAMMERTIME_BUS_BROKERS=localhost:19092
HAMMERTIME_TOPIC_OBSERVATIONS=hammertime.observations.v1
HAMMERTIME_TOPIC_HOT_IP=hammertime.hot-ip.v1
HAMMERTIME_TOPIC_PREFIX_STATS=hammertime.prefix-stats.v1
HAMMERTIME_TOPIC_DETECTIONS=hammertime.detections.v1

# --- state stores -----------------------------------------------------------
HAMMERTIME_STORE_KIND=redis          # redis | memory
# Accepted schemes: redis://, rediss://, unix:// -- checked at startup under redis.
HAMMERTIME_REDIS_URL=redis://localhost:6379/0

# --- ingest -----------------------------------------------------------------
HAMMERTIME_INGEST_BIND=0.0.0.0:8080
HAMMERTIME_INGEST_MAX_BODY_BYTES=1048576
HAMMERTIME_INGEST_MAX_OBSERVATIONS=10000
HAMMERTIME_INGEST_RATE_LIMIT_RPS=50
# Registry of agent credentials; stores keyed hashes only, never tokens (ADR-0006, spec 36.2).
HAMMERTIME_INGEST_AGENTS_PATH=./config/agents.v2.json
# Deployment-wide key the registry's token hashes are computed under (spec 36.1).
# base64url, >= 32 bytes decoded. Ingest refuses to start without it. The value
# below is a publicly known placeholder matching the committed sample registry
# so the local stack starts; generate a real one per deployment with
# `uv run hammertime-agent-token new-key` and never commit it.
HAMMERTIME_INGEST_AGENT_TOKEN_KEY=REPLACE_ME_local_dev_only_key_do_not_use_00
# Failed-authentication throttling (ADR-0007, spec 36.5): failures/min and
# burst capacity for the source-address bucket (IPv4 /32, IPv6 /64).
HAMMERTIME_INGEST_AUTH_FAILURE_RATE_PER_MIN=30
HAMMERTIME_INGEST_AUTH_FAILURE_BURST=10
# Same, keyed by the attempted X-Agent-Id (or "-" if absent/malformed).
HAMMERTIME_INGEST_AUTH_FAILURE_AGENT_RATE_PER_MIN=60
HAMMERTIME_INGEST_AUTH_FAILURE_AGENT_BURST=20
# 0 = trust no X-Forwarded-For (use the socket peer address); N > 0 = take
# the Nth-from-the-right X-Forwarded-For entry behind N trusted proxies.
HAMMERTIME_INGEST_TRUSTED_PROXY_HOPS=0
# Per-agent observation budget (ADR-0008, spec 36.6): charged per distinct
# IP in a batch, not per request. Burst MUST be >= HAMMERTIME_INGEST_MAX_OBSERVATIONS.
HAMMERTIME_INGEST_OBSERVATION_RATE_LIMIT_EPS=2000
HAMMERTIME_INGEST_OBSERVATION_BURST=10000

# --- aggregator -------------------------------------------------------------
# A shard is a partition of hammertime.observations.v1 (ADR-0011): `auto`
# lets the consumer group assign partitions, and an explicit set
# (`0`, `0-3`, `0,2,5-7`) pins this member to exactly those partitions and
# takes it out of group coordination. A set-but-empty value is refused at
# startup; `auto` is the only way to say "let the group decide".
HAMMERTIME_SHARD_IDS=auto
# How often consumed offsets are committed (ADR-0011 decision 6).
HAMMERTIME_AGGREGATOR_COMMIT_INTERVAL_S=1.0
# Per-shard cap on tracked IPs. Over it, the least recently seen COLD IP is
# evicted; a store of only HOT IPs grows past the cap instead.
HAMMERTIME_AGGREGATOR_MAX_TRACKED_IPS=1000000
# IPs re-evaluated per slice after a detection-config change (spec 34).
HAMMERTIME_AGGREGATOR_REEVALUATION_BATCH=1000

# --- trie -------------------------------------------------------------------
HAMMERTIME_TRIE_QUERY_BIND=0.0.0.0:8081
HAMMERTIME_TRIE_SNAPSHOT_DIR=./snapshots
HAMMERTIME_TRIE_SNAPSHOT_INTERVAL_S=300
